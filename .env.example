# =============================================================================
# AutoDrive Motors JAO - Plantilla de variables para el perfil "supabase"
# =============================================================================
# Cómo se usa:
#   1. Copie este archivo como .env en la raíz del proyecto (misma carpeta que
#      pom.xml). El archivo .env está en .gitignore: nunca se sube al repositorio.
#   2. Complete los valores reales.
#   3. Ejecute:  powershell -ExecutionPolicy Bypass -File scripts\supabase-run.ps1
#
# IMPORTANTE: Spring Boot NO lee archivos .env por sí solo. Ese script lee este
# archivo, crea las variables de entorno en la sesión y luego arranca la
# aplicación. Si arranca con "mvn spring-boot:run" directamente, estas variables
# deben existir en la terminal ($env:SUPABASE_DB_URL = "...").
# =============================================================================

# --- Conexión a PostgreSQL de Supabase (obligatorias) ------------------------
# El valor se copia desde Supabase -> Project Settings -> Database -> Connection string (URI)
# y se convierte a formato JDBC agregando el prefijo "jdbc:".
#
# Conexión directa (IPv6; requiere red con IPv6):
#   jdbc:postgresql://db.<referencia-proyecto>.supabase.co:5432/postgres?sslmode=require
#
# Pooler de sesión (IPv4, recomendado si la red no tiene IPv6):
#   jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Pooler de transacciones (IPv4, puerto 6543): pgJDBC debe desactivar las
# sentencias preparadas o falla con "prepared statement already exists".
#   jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
SUPABASE_DB_URL=jdbc:postgresql://db.<referencia-proyecto>.supabase.co:5432/postgres?sslmode=require

# Usuario de base de datos. En el pooler el usuario lleva la referencia del
# proyecto: postgres.<referencia-proyecto>
SUPABASE_DB_USER=postgres

# Contraseña de la base. Se obtiene del dueño del proyecto por un canal privado
# y NUNCA se escribe en README, capturas, documentación ni commits.
SUPABASE_DB_PASSWORD=

# --- Cuenta de administrador de la aplicación (obligatorias) -----------------
# No se almacenan en la base de datos: la aplicación las usa en memoria con BCrypt.
# Si quedan vacías, el login del panel no funciona.
AUTODRIVE_ADMIN_USER=
AUTODRIVE_ADMIN_PASSWORD=

# --- Opcionales --------------------------------------------------------------
# Perfil de Spring Boot que selecciona application-supabase.yml.
SPRING_PROFILES_ACTIVE=supabase

# Dirección donde escucha el servidor. 127.0.0.1 permite probar en local;
# al desplegar en un servidor real use 0.0.0.0.
AUTODRIVE_SERVER_ADDRESS=127.0.0.1

# La cookie de sesión solo se marca Secure bajo HTTPS. En localhost HTTP debe
# quedar en false, de lo contrario el navegador no la devuelve y no hay login.
AUTODRIVE_SESSION_COOKIE_SECURE=false

# Servicio público de tasa de cambio (tiene valor por defecto; se puede sustituir).
# AUTODRIVE_TASA_CAMBIO_URL=https://open.er-api.com/v6/latest/USD
